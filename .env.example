# Amazon Bedrock API key (bearer token) — read automatically by boto3 (Haystack)
# and LiteLLM (DSPy). No AWS access key / secret key needed.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here

# Region where your Bedrock Claude models are enabled.
AWS_REGION=us-east-1

# "Production" model — deliberately the small/cheap tier, mirroring the demo's
# weak llama-3.1-8b so the optimisation gains are visible.
BEDROCK_PROD_MODEL=anthropic.claude-haiku-4-5

# Judge + GEPA reflection model — should be stronger than the production model.
BEDROCK_JUDGE_MODEL=anthropic.claude-opus-4-8
